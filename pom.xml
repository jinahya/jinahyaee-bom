<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>jinahya-parent</artifactId>
    <!-- https://central.sonatype.com/artifact/io.github.jinahya/jinahya-parent/versions -->
    <version>1.1.4</version>
  </parent>

  <groupId>io.github.jinahya</groupId>
  <artifactId>jinahyaee-bom</artifactId>
  <version>0.0.3-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>${project.artifactId}</name>
  <description>The parent of the jinahyaee-bom-NN bills of materials; import one of those, not this</description>
  <!-- url and scm name this repository literally, never ${project.artifactId}, and are inherited unchanged (the
       inherit.append.path attributes): every module is in this one repository -->
  <url>https://github.com/jinahya/jinahyaee-bom</url>

  <!-- One bill of materials per Jakarta EE generation, each managing the jinahya-* artifacts of that generation, as
       jakarta.platform:jakarta.jakartaee-bom does the jakarta.* APIs; all of them are released together, at this
       project's version, with the generation in their artifactIds (jinahyaee-bom-11, ...). -->
  <modules>
    <module>jinahyaee-bom-10</module>
    <module>jinahyaee-bom-11</module>
  </modules>

  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:git@github.com:jinahya/jinahyaee-bom.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/jinahyaee-bom.git</developerConnection>
    <url>https://github.com/jinahya/jinahyaee-bom</url>
    <tag>HEAD</tag>
  </scm>

  <!-- The version of each member project, one for all of its generations; a bill of materials is released only with
       released versions, which the maven-release-plugin checks. -->
  <properties>
    <!-- https://github.com/jinahya/jinahya-persistence -->
    <!-- https://central.sonatype.com/artifact/io.github.jinahya/jinahya-persistence-utils-11/versions -->
    <version.io.github.jinahya.jinahya-persistence>0.7.1</version.io.github.jinahya.jinahya-persistence>
    <!-- https://github.com/jinahya/jinahya-validation -->
    <!-- https://central.sonatype.com/artifact/io.github.jinahya/jinahya-validation-utils-11/versions -->
    <version.io.github.jinahya.jinahya-validation>0.0.3</version.io.github.jinahya.jinahya-validation>
  </properties>
</project>
